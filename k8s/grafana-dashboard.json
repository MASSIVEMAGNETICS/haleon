{
  "dashboard": {
    "title": "HLHFM + Eidolon-Ω System Dashboard",
    "panels": [
      {
        "title": "HLHFM Query Latency (p99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(hlhfm_query_latency_ms_bucket[5m]))",
            "legendFormat": "p99 latency"
          }
        ],
        "type": "graph"
      },
      {
        "title": "HLHFM Total Entries",
        "targets": [
          {
            "expr": "hlhfm_entries_total",
            "legendFormat": "Total Entries"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Eidolon Inference Latency (p99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(eidolon_inference_latency_ms_bucket[5m]))",
            "legendFormat": "p99 latency"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Eidolon FAD Score",
        "targets": [
          {
            "expr": "rate(eidolon_fad_score_sum[5m]) / rate(eidolon_fad_score_count[5m])",
            "legendFormat": "Average FAD Score"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Eidolon CLAP Score",
        "targets": [
          {
            "expr": "rate(eidolon_clap_score_sum[5m]) / rate(eidolon_clap_score_count[5m])",
            "legendFormat": "Average CLAP Score"
          }
        ],
        "type": "graph"
      },
      {
        "title": "Total Requests",
        "targets": [
          {
            "expr": "sum(rate(hlhfm_queries_total[5m]))",
            "legendFormat": "HLHFM Queries/sec"
          },
          {
            "expr": "sum(rate(eidolon_generations_total[5m]))",
            "legendFormat": "Eidolon Generations/sec"
          }
        ],
        "type": "graph"
      }
    ],
    "refresh": "10s",
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  }
}
